# ---- environment ------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Kalshi -----------------------------------------------------------------
# demo = https://demo-api.kalshi.co (fake money) | prod = https://api.elections.kalshi.com
KALSHI_ENV=demo
# Create an API key at https://kalshi.com/account/profile (demo: https://demo.kalshi.co)
KALSHI_API_KEY_ID=
# Either a path to the PEM file ...
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi-demo.pem
# ... or the PEM inline (multi-line values need quotes; prefer a secrets manager in prod)
# KALSHI_PRIVATE_KEY_PEM=

# ---- trading mode -----------------------------------------------------------
# paper = simulated fills, virtual P&L | live = real orders
TRADING_MODE=paper
# Required (true) before TRADING_MODE=live will start against KALSHI_ENV=prod
LIVE_TRADING_ACKNOWLEDGED=false

# ---- persistence ------------------------------------------------------------
# local dev default is sqlite; docker compose overrides with postgres
DATABASE_URL=sqlite:///./kalshi_dev.db
REDIS_URL=redis://localhost:6379/0

# ---- collector --------------------------------------------------------------
COLLECTOR_INTERVAL_SECONDS=30
# JSON list of series to follow; empty = all open markets (capped by COLLECTOR_MAX_MARKETS)
COLLECTOR_SERIES_TICKERS=[]
COLLECTOR_MAX_MARKETS=500

# ---- engine -----------------------------------------------------------------
ENGINE_INTERVAL_SECONDS=60
STRATEGY_NAME=simple_edge
STRATEGY_PARAMS={"lookback": 10, "min_discount": 3, "contracts": 5}

# ---- risk limits (cents) ----------------------------------------------------
RISK_MIN_EDGE=0.04
RISK_MAX_ORDER_CONTRACTS=25
RISK_MAX_POSITION_CONTRACTS=100
RISK_MAX_MARKET_EXPOSURE_CENTS=5000
RISK_MAX_TOTAL_EXPOSURE_CENTS=50000
RISK_MAX_DAILY_LOSS_CENTS=5000
RISK_MIN_LIQUIDITY_CONTRACTS=50
RISK_MAX_SPREAD_CENTS=10
RISK_KILL_SWITCH_FILE=./KILL_SWITCH

# ---- paper trading ----------------------------------------------------------
PAPER_STARTING_BALANCE_CENTS=100000
PAPER_FILL_SLIPPAGE_CENTS=1

# ---- api --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
