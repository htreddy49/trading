# ---- environment ------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Kalshi -----------------------------------------------------------------
# prod = your real kalshi.com account (safe with TRADING_MODE=paper: read-only, no orders)
# demo = https://demo-api.kalshi.co, a separate sandbox account with fake money
KALSHI_ENV=prod
# Create an API key at https://kalshi.com/account/profile
KALSHI_API_KEY_ID=
# Either a path to the PEM file ...
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi.pem
# ... or the PEM inline (multi-line values need quotes; prefer a secrets manager in prod)
# KALSHI_PRIVATE_KEY_PEM=

# ---- trading mode -----------------------------------------------------------
# paper = simulated fills, virtual P&L | live = real orders
TRADING_MODE=paper
# Required (true) before TRADING_MODE=live will start against KALSHI_ENV=prod
LIVE_TRADING_ACKNOWLEDGED=false

# ---- persistence ------------------------------------------------------------
# local dev default is sqlite; docker compose overrides with postgres
DATABASE_URL=sqlite:///./kalshi_dev.db
REDIS_URL=redis://localhost:6379/0

# ---- collector --------------------------------------------------------------
# 15-minute markets move fast: poll often and follow only the crypto series
COLLECTOR_INTERVAL_SECONDS=10
# JSON list of series to follow; empty = all open markets (capped by COLLECTOR_MAX_MARKETS)
COLLECTOR_SERIES_TICKERS=["KXBTC15M","KXETH15M"]
COLLECTOR_MAX_MARKETS=200

# ---- engine -----------------------------------------------------------------
# The averaging-gap strategy acts inside a 25-second window, so the loop must be fast.
ENGINE_INTERVAL_SECONDS=2
STRATEGY_NAME=averaging_gap
# Trades only between min and max seconds before the close, and only when the model price
# lands in the band where the fee is small and the error tolerance is still workable.
STRATEGY_PARAMS={"contracts": 5, "min_seconds_left": 15, "max_seconds_left": 40, "min_model_price_cents": 85, "max_model_price_cents": 96, "min_edge_cents": 3}

# ---- risk limits (cents) ----------------------------------------------------
# 15-minute crypto markets are ~50c, where the taker fee is at its maximum (~1.75c),
# so demand a wide edge before paying it.
RISK_MIN_EDGE=0.05
RISK_MAX_ORDER_CONTRACTS=10
RISK_MAX_POSITION_CONTRACTS=20
RISK_MAX_MARKET_EXPOSURE_CENTS=1000
RISK_MAX_TOTAL_EXPOSURE_CENTS=10000
RISK_MAX_DAILY_LOSS_CENTS=2000
RISK_MIN_LIQUIDITY_CONTRACTS=20
RISK_MAX_SPREAD_CENTS=6
RISK_KILL_SWITCH_FILE=./KILL_SWITCH

# a market only lives 15 minutes, so allow a re-entry sooner than the 5 minute default
RISK_DUPLICATE_WINDOW_SECONDS=120

# ---- paper trading ----------------------------------------------------------
PAPER_STARTING_BALANCE_CENTS=100000
PAPER_FILL_SLIPPAGE_CENTS=1

# ---- recorder ---------------------------------------------------------------
CAPTURES_DIR=./captures

# ---- api --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
